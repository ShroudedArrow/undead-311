{
  "name": "undead311-web",
  "private": true,
  "version": "0.0.1",
  "description": "The Undead 311 static site (Vite + React + TypeScript).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "check-build": "node scripts/check-build.mjs",
    "check-tour": "node scripts/check-tour.ts",
    "build": "node scripts/gen-corrections.mjs && node scripts/make-street-index.ts && node scripts/check-tour.ts && tsc --noEmit && vite build && node scripts/write-headers.ts && node scripts/check-build.mjs --strict",
    "typecheck": "tsc --noEmit",
    "gen:parsers": "node scripts/gen-parsers.mjs",
    "gen:corrections": "node scripts/gen-corrections.mjs",
    "gen:streets": "node scripts/make-street-index.ts",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mapbox": "^9.4.1",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "ajv": "^8.20.0",
    "maplibre-gl": "^6.18.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
