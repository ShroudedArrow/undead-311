{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undead-311/schemas/judge_tour.schema.json",
  "title": "Judge-mode tour",
  "description": "REQ-STAT-TOUR, REQ-WEB-JUDGE.",
  "type": "object",
  "properties": {
    "data_version": {
      "type": "string"
    },
    "provisional": {
      "type": "boolean"
    },
    "zombie_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "source": {
      "enum": [
        "override",
        "most_reports"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "WINDOW_DAYS": {
          "type": "integer"
        },
        "RADIUS_M": {
          "type": "number"
        },
        "matching": {
          "type": "string"
        }
      },
      "required": [
        "WINDOW_DAYS",
        "RADIUS_M",
        "matching"
      ]
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "data_version",
    "params",
    "provisional",
    "seed",
    "source",
    "zombie_ids"
  ],
  "additionalProperties": true
}
