{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undead-311/schemas/card.schema.json",
  "title": "Autopsy cards (one shard)",
  "description": "REQ-EXP-1, REQ-EXP-SIZE. Sharded by neighborhood and year.",
  "type": "object",
  "properties": {
    "data_version": {
      "type": "string"
    },
    "shard": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zombie_id": {
            "type": "string"
          },
          "original": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "system": {
                "enum": [
                  "legacy",
                  "new"
                ]
              },
              "open_time": {
                "type": "string"
              },
              "close_time": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type_raw": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "closure_text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "street": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "lat",
              "lon",
              "open_time",
              "system",
              "type_raw"
            ],
            "additionalProperties": true
          },
          "rereport": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "system": {
                "enum": [
                  "legacy",
                  "new"
                ]
              },
              "open_time": {
                "type": "string"
              },
              "close_time": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type_raw": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "closure_text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "street": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "lat",
              "lon",
              "open_time",
              "system",
              "type_raw"
            ],
            "additionalProperties": true
          },
          "cause_of_death": {
            "enum": [
              "resolved",
              "noted",
              "invalid",
              "duplicate",
              "referred",
              "made_safe_temporary",
              "planned_followup",
              "bulk_backlog",
              "other"
            ]
          },
          "gap_days": {
            "type": "number",
            "minimum": 0
          },
          "resurrection_date": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "tier": {
            "enum": [
              "headline",
              "source_unknown",
              "sensitivity"
            ]
          },
          "skeptic_verdict": {
            "enum": [
              "survives",
              "weakened",
              "explained_away",
              "not_reviewed"
            ]
          },
          "skeptic_notes": {
            "type": "string"
          },
          "reports_after": {
            "type": "integer",
            "minimum": 1
          },
          "times_risen": {
            "type": "integer",
            "minimum": 1
          },
          "bulk_closure": {
            "type": "boolean"
          }
        },
        "required": [
          "cause_of_death",
          "confidence",
          "gap_days",
          "original",
          "rereport",
          "resurrection_date",
          "skeptic_notes",
          "skeptic_verdict",
          "tier",
          "zombie_id"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "cards",
    "data_version",
    "shard"
  ],
  "additionalProperties": true
}
