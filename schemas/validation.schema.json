{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undead-311/schemas/validation.schema.json",
  "title": "Field validation",
  "description": "REQ-STAT-VAL.",
  "type": "object",
  "properties": {
    "data_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "awaiting_field_labels",
        "scored"
      ]
    },
    "precision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rate": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "lo": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "hi": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "k": {
              "type": "integer",
              "minimum": 0
            },
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "hi",
            "lo",
            "n",
            "rate"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "cant_tell_share": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "kappa": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sample_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "confirmed",
    "data_version",
    "status"
  ],
  "additionalProperties": true
}
