{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undead-311/schemas/validation.schema.json",
  "title": "Validation of the sample (field labels or records-based check)",
  "description": "REQ-STAT-VAL. `method` field: two raters on the street; records: how the city closed each re-report (REQ-STAT-VAL.5), where `precision` is the share repaired again over all sampled zombies and `confirmed` the record-confirmed ones.",
  "type": "object",
  "properties": {
    "data_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "awaiting_field_labels",
        "scored"
      ]
    },
    "precision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rate": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "lo": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "hi": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "k": {
              "type": "integer",
              "minimum": 0
            },
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "hi",
            "lo",
            "n",
            "rate"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "cant_tell_share": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "kappa": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sample_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kappa_still_broken": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "n_paired": {
      "type": "integer",
      "minimum": 0
    },
    "method": {
      "enum": [
        "field",
        "records"
      ]
    },
    "records": {
      "type": "object",
      "properties": {
        "checked_on": {
          "type": "string"
        },
        "classes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "ambiguous_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambiguous_reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "repaired_again_with_ambiguous": {
          "type": "object"
        },
        "repaired_again_of_closed": {
          "type": "object"
        },
        "by_type": {
          "type": "object"
        }
      },
      "required": [
        "checked_on",
        "classes",
        "ambiguous_ids"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "confirmed",
    "data_version",
    "status"
  ],
  "additionalProperties": true
}
