{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undead-311/schemas/excess.schema.json",
  "title": "Excess resurrections",
  "description": "REQ-STAT-BASE, REQ-STAT-SHIFT, REQ-STAT-PLACEBO. `shift` is the time-shift permutation result and `placebo` the placebo-outcome excess; both optional (ops#64).",
  "type": "object",
  "properties": {
    "data_version": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "department",
              "family",
              "neighborhood"
            ]
          },
          "name": {
            "type": "string"
          },
          "observed": {
            "type": "integer",
            "minimum": 0
          },
          "expected": {
            "type": "number"
          },
          "excess": {
            "type": "number"
          },
          "lo": {
            "type": "number"
          },
          "hi": {
            "type": "number"
          },
          "tier_set": {
            "enum": [
              "headline",
              "all"
            ]
          }
        },
        "required": [
          "excess",
          "expected",
          "hi",
          "kind",
          "lo",
          "name",
          "observed",
          "tier_set"
        ],
        "additionalProperties": true
      }
    },
    "shift": {
      "type": "object",
      "description": "REQ-STAT-SHIFT: observed count against the distribution of counts under random time shifts.",
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "mean": {
          "type": "number"
        },
        "q025": {
          "type": "number"
        },
        "q975": {
          "type": "number"
        }
      },
      "required": [
        "runs",
        "seed",
        "observed",
        "mean",
        "q025",
        "q975"
      ],
      "additionalProperties": true
    },
    "placebo": {
      "type": "object",
      "description": "REQ-STAT-PLACEBO: excess for a placebo outcome that should be about zero, with its interval.",
      "properties": {
        "excess": {
          "type": "number"
        },
        "lo": {
          "type": "number"
        },
        "hi": {
          "type": "number"
        }
      },
      "required": [
        "excess",
        "lo",
        "hi"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "data_version",
    "rows"
  ],
  "additionalProperties": true
}
