{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undead-311/schemas/districts.schema.json",
  "title": "District summaries",
  "description": "REQ-EXP-SIZE.3, REQ-WEB-OPEN.2. Headline possible zombies per council district, by family and by year, for the report cards.",
  "type": "object",
  "properties": {
    "data_version": {
      "type": "string"
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "district": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "by_family": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "family": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "family",
                "count"
              ],
              "additionalProperties": true
            }
          },
          "by_year": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "year",
                "count"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "district",
          "count",
          "by_family",
          "by_year"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "data_version",
    "districts"
  ],
  "additionalProperties": true
}
