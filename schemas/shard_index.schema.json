{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undead-311/schemas/shard_index.schema.json",
  "title": "Shard index",
  "description": "REQ-EXP-SIZE.3. Lists the shards of `zombies/` or `incidents/` so the site loads only the ones it needs.",
  "type": "object",
  "properties": {
    "data_version": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "zombies",
        "incidents"
      ]
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shard": {
            "type": "string"
          },
          "neighborhood": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "year": {
            "type": "integer"
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "districts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tiers": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "shard",
          "neighborhood",
          "year",
          "n",
          "districts"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "data_version",
    "kind",
    "shards"
  ],
  "additionalProperties": true
}
