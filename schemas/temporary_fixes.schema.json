{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undead-311/schemas/temporary_fixes.schema.json",
  "title": "How often temporary fixes come back",
  "description": "REQ-STAT-TEMP.",
  "type": "object",
  "properties": {
    "data_version": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string"
          },
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "n_made_safe": {
            "type": "integer",
            "minimum": 0
          },
          "after_temporary_fix": {
            "type": "object",
            "properties": {
              "rate": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lo": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hi": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "k": {
                "type": "integer",
                "minimum": 0
              },
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "hi",
              "lo",
              "n",
              "rate"
            ],
            "additionalProperties": true
          },
          "source_unknown": {
            "type": "object",
            "properties": {
              "rate": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lo": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hi": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "k": {
                "type": "integer",
                "minimum": 0
              },
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "hi",
              "lo",
              "n",
              "rate"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "after_temporary_fix",
          "family",
          "n_made_safe",
          "source_unknown"
        ],
        "additionalProperties": true
      }
    },
    "separate_deaths": {
      "type": "object",
      "properties": {
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "duplicate",
        "invalid"
      ],
      "additionalProperties": true
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": [
    "data_version",
    "exclusions",
    "rows",
    "separate_deaths"
  ],
  "additionalProperties": true
}
