{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undead-311/schemas/survival.schema.json",
  "title": "Survival curves (Kaplan-Meier)",
  "description": "REQ-STAT-KM. survival[0] = 1, non-increasing.",
  "type": "object",
  "properties": {
    "data_version": {
      "type": "string"
    },
    "curves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "tier_set": {
            "enum": [
              "headline",
              "all"
            ]
          },
          "times": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "survival": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "lo": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "hi": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "at_7": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "at_30": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "at_90": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "half_life": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "at_30",
          "at_7",
          "at_90",
          "half_life",
          "hi",
          "lo",
          "name",
          "survival",
          "tier_set",
          "times"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "curves",
    "data_version"
  ],
  "additionalProperties": true
}
