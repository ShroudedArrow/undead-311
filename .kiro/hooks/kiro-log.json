{
  "version": "v1",
  "hooks": [
    {
      "name": "kiro-log",
      "description": "Append date, surface and a changed-files summary to docs/KIRO_LOG.md (command, no credits).",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "S=/projects/sandbox/undead-311/scripts/kiro_log_hook.py; [ -f \"$S\" ] || exit 0; cd /projects/sandbox/undead-311 || exit 0; exec python3 \"$S\""
      },
      "timeout": 30
    }
  ]
}
