{
  "version": "v1",
  "hooks": [
    {
      "name": "coroner-eval",
      "description": "Coroner accuracy vs. 200 hand labels when the label table changes.",
      "trigger": "PostFileSave",
      "matcher": "(^|/)data/labels/coroner_labels\\.csv$",
      "action": {
        "type": "command",
        "command": "[ -f /projects/sandbox/undead-311/Makefile ] || exit 0; exec make -C /projects/sandbox/undead-311 coroner-eval"
      },
      "timeout": 120
    }
  ]
}
