{
  "version": "v1",
  "hooks": [
    {
      "name": "channel-status",
      "description": "Post a one-line status comment to the current run-log issue after each task. Always exits 0.",
      "trigger": "PostTaskExec",
      "action": {
        "type": "command",
        "command": "S=/projects/sandbox/undead-311/scripts/channel_post.py; [ -f \"$S\" ] || exit 0; cd /projects/sandbox/undead-311 || exit 0; exec python3 \"$S\""
      },
      "timeout": 30
    }
  ]
}
