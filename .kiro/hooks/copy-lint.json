{
  "version": "v1",
  "hooks": [
    {
      "name": "copy-lint",
      "description": "Flag banned words/patterns and banned CSS defaults; count TODO-COPY. Disabled by default: the workflow design gate runs it.",
      "trigger": "PostFileSave",
      "matcher": "(^|/)(web/src/|docs/|drafts/)|(^|/)README\\.md$",
      "action": {
        "type": "command",
        "command": "[ -f /projects/sandbox/undead-311/Makefile ] || exit 0; exec make -C /projects/sandbox/undead-311 copy-lint"
      },
      "timeout": 60,
      "enabled": false
    }
  ]
}
