{
  "version": "v1",
  "hooks": [
    {
      "name": "test-on-save",
      "description": "Run the fast test subset when pipeline or web source is saved. Disabled by default: workflow validate gates run the tests.",
      "trigger": "PostFileSave",
      "matcher": "(^|/)pipeline/.*\\.py$|(^|/)web/src/.*\\.(ts|tsx)$",
      "action": {
        "type": "command",
        "command": "[ -f /projects/sandbox/undead-311/Makefile ] || exit 0; exec make -C /projects/sandbox/undead-311 test-fast"
      },
      "timeout": 60,
      "enabled": false
    }
  ]
}
