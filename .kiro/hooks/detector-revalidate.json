{
  "version": "v1",
  "hooks": [
    {
      "name": "detector-revalidate",
      "description": "Re-score the hand-labeled validation sample when detector code changes.",
      "trigger": "PostFileSave",
      "matcher": "(^|/)pipeline/undead311/detect/",
      "action": {
        "type": "command",
        "command": "[ -f /projects/sandbox/undead-311/Makefile ] || exit 0; exec make -C /projects/sandbox/undead-311 validate"
      },
      "timeout": 120
    }
  ]
}
