{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "duckdb": {
      "command": "uvx",
      "args": [
        "mcp-server-motherduck",
        "--db-path",
        "/ABSOLUTE/PATH/TO/undead311-data/processed/undead311.duckdb",
        "--read-only"
      ]
    },
    "ckan": {
      "command": "npx",
      "args": [
        "-y",
        "@aborruso/ckan-mcp-server"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "github-channel": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_CHANNEL_TOKEN}"
      }
    }
  }
}
